<PageHeader class="d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            @if (!string.IsNullOrEmpty(Pretitle))
            {
                <PagePretitle>@Pretitle</PagePretitle>
            }
            <PageMainTitle HtmlTag="h2">@Title @TitleExtra</PageMainTitle>
        </div>
        @if (Actions != null)
        {
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list align-items-center">@Actions</div>
            </div>
        }
    </div>
</PageHeader>

@code {
    [Parameter]
    public string Pretitle { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; }

    [Parameter]
    public RenderFragment TitleExtra { get; set; }

    [Parameter]
    public RenderFragment Actions { get; set; }
}
