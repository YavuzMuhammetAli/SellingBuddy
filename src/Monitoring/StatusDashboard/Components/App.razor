<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* theme applied before css loads, avoids a light flash *@
    <script>
        try { document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('sb-status-theme') || 'light'); } catch (e) { }
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="https://unpkg.com/@@tabler/core@1.7.0/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="_content/TabBlazor/css/tabblazor.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["StatusDashboard.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="_content/TabBlazor/js/tabblazor.js"></script>
    <script src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
