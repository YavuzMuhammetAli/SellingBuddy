{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Consul": {
    "Address": "http://localhost:8500"
  },
  "RabbitMQ": {
    "ManagementUrl": "http://localhost:15672",
    "UserName": "guest",
    "Password": "guest"
  },
  "Monitoring": {
    "RefreshSeconds": 10,
    "HistoryLength": 30,
    "StaticTargets": [
      { "Name": "Web.ApiGateway", "HealthUrl": "http://localhost:5131/health" },
      { "Name": "WebApp", "HealthUrl": "http://localhost:5198/health" }
    ],
    "WorkerTargets": [
      { "Name": "NotificationService", "QueuePrefix": "NotificationService." }
    ],
    "InfrastructureTargets": [
      { "Name": "SQL Server", "Kind": "sqlserver", "Host": "localhost", "Port": 1435 },
      { "Name": "Redis", "Kind": "redis", "Host": "localhost", "Port": 6389 },
      { "Name": "RabbitMQ", "Kind": "rabbitmq", "Host": "localhost", "Port": 5672 },
      { "Name": "Consul", "Kind": "consul", "Host": "localhost", "Port": 8500 }
    ]
  },
  "AllowedHosts": "*"
}
