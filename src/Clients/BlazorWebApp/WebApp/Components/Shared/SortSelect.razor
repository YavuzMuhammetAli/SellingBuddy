<label class="sr-only" for="@id">@L["Sort.Label"]</label>
<select id="@id" class="select" style="@(Block ? "width:100%" : null)" value="@Value" @onchange="OnChange">
    @foreach (var option in Options)
    {
        <option value="@option">@L[$"Sort.{option}"]</option>
    }
</select>

@code {
    [Parameter] public string Value { get; set; }
    [Parameter] public string[] Options { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Block { get; set; }

    private readonly string id = $"sort-{Guid.NewGuid():N}";

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
