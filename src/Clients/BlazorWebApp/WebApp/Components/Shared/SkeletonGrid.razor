<div class="product-grid @Class" aria-busy="true" aria-label="@L["Common.Loading"]">
    @for (var i = 0; i < Count; i++)
    {
        <div class="skeleton skeleton-card"></div>
    }
</div>

@code {
    [Parameter]
    public int Count { get; set; } = 8;

    [Parameter]
    public string Class { get; set; }
}
