<div class="card h-100 product-card">
    <img src="@Item.PictureUri" class="card-img-top" alt="@Item.Name" />
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Item.Name</h5>
        <p class="card-text text-muted small flex-grow-1">@Item.Description</p>
        <div class="d-flex justify-content-between align-items-center">
            <span class="fw-bold">@Item.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
            <button class="btn btn-primary btn-sm" disabled="@(Item.AvailableStock <= 0 || IsBusy)" @onclick="() => OnAddToBasket.InvokeAsync(Item)">
                @(Item.AvailableStock <= 0 ? "Out of stock" : "Add to basket")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CatalogItem Item { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback<CatalogItem> OnAddToBasket { get; set; }
}
