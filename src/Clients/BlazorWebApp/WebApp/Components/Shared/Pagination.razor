@if (TotalPages > 1)
{
    <nav class="pagination" aria-label="@L["Pagination.Label"]">
        <button type="button" aria-label="@L["Pagination.Previous"]" disabled="@(PageIndex == 0)" @onclick="() => GoAsync(PageIndex - 1)"><AppIcon Name="chevron_left" /></button>
        @foreach (var page in Pages())
        {
            if (page < 0)
            {
                <span class="muted">…</span>
            }
            else
            {
                <button type="button" class="@(page == PageIndex ? "active" : null)" aria-current="@(page == PageIndex ? "page" : null)" @onclick="() => GoAsync(page)">@(page + 1)</button>
            }
        }
        <button type="button" aria-label="@L["Pagination.Next"]" disabled="@(PageIndex >= TotalPages - 1)" @onclick="() => GoAsync(PageIndex + 1)"><AppIcon Name="chevron_right" /></button>
    </nav>
}

@code {
    [Parameter]
    public int PageIndex { get; set; }

    [Parameter]
    public int TotalPages { get; set; }

    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    //first, last and the pages around the current one, -1 is a gap
    private IEnumerable<int> Pages()
    {
        var last = -2;

        for (var page = 0; page < TotalPages; page++)
        {
            if (page == 0 || page == TotalPages - 1 || Math.Abs(page - PageIndex) <= 1)
            {
                if (page - last > 1 && last >= 0)
                    yield return -1;

                yield return page;
                last = page;
            }
        }
    }

    private Task GoAsync(int page) => OnPageChanged.InvokeAsync(Math.Clamp(page, 0, TotalPages - 1));
}
