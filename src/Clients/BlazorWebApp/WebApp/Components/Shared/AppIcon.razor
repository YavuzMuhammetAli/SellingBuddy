@if (AppIconPaths.Icons.TryGetValue(Filled && AppIconPaths.Icons.ContainsKey(Name + "_fill") ? Name + "_fill" : Name, out var icon))
{
    <svg class="icon @Class" viewBox="@icon.ViewBox" aria-hidden="true" focusable="false" style="@(Size.HasValue ? $"font-size:{Size}px" : null)"><path d="@icon.Path" /></svg>
}

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; }

    [Parameter]
    public bool Filled { get; set; }

    [Parameter]
    public int? Size { get; set; }

    [Parameter]
    public string Class { get; set; }
}
