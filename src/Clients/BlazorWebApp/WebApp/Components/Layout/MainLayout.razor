@inherits LayoutComponentBase
@inject StorefrontState State
@inject ICatalogService CatalogService

<a class="sr-only" href="#main">@L["Common.SkipToContent"]</a>

<SiteHeader FirstCampaign="@firstCampaign" />

<main id="main" class="container">
    @Body
</main>

<SiteFooter />
<BottomNav />
<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    @L["Error.Unhandled"]
    <a href="." class="reload">@L["Error.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string firstCampaign;

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureLoadedAsync();

        try
        {
            //campaign pill links to the first running campaign
            firstCampaign = (await CatalogService.GetCampaignsAsync()).FirstOrDefault()?.Slug;
        }
        catch (HttpRequestException)
        {
            firstCampaign = null;
        }
    }
}
