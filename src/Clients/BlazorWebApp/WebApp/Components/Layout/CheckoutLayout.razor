@inherits LayoutComponentBase
@inject StorefrontState State

<header class="checkout-header">
    <div class="container">
        <a href="" class="brand" aria-label="SellingBudy"><span>Selling<b>Budy</b></span><span class="brand-dot"></span></a>
        <ol class="stepper" aria-label="@L["Checkout.Steps"]">
            <li class="step done"><b>1</b>@L["Checkout.StepAddress"]</li>
            <li class="step-sep" aria-hidden="true">—</li>
            <li class="step done"><b>2</b>@L["Checkout.StepShipping"]</li>
            <li class="step-sep" aria-hidden="true">—</li>
            <li class="step current"><b>3</b>@L["Checkout.StepPayment"]</li>
            <li class="step-sep" aria-hidden="true">—</li>
            <li class="step"><b>4</b>@L["Checkout.StepConfirm"]</li>
        </ol>
        <span class="flex items-center gap-xs t-label-md text-success"><AppIcon Name="verified_user" Size="18" /> @L["Checkout.SecurePayment"]</span>
    </div>
</header>

<main id="main" class="container">
    @Body
</main>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    @L["Error.Unhandled"]
    <a href="." class="reload">@L["Error.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override Task OnInitializedAsync() => State.EnsureLoadedAsync();
}
