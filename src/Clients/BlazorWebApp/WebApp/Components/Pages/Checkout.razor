@page "/checkout"
@inject IBasketService BasketService

<PageTitle>Checkout</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Checkout</h1>

        @if (completed)
        {
            <div class="alert alert-success">
                Your order was received. It is processed in the background, see <a href="orders">My Orders</a>.
            </div>
        }
        else
        {
            @if (error != null)
            {
                <div class="alert alert-danger py-2">@error</div>
            }

            <EditForm Model="model" OnValidSubmit="CheckoutAsync" FormName="checkout" Context="formContext">
                <DataAnnotationsValidator />

                <h5 class="mt-3">Shipping address</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Street</label>
                        <InputText class="form-control" @bind-Value="model.Street" />
                        <ValidationMessage For="() => model.Street" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">City</label>
                        <InputText class="form-control" @bind-Value="model.City" />
                        <ValidationMessage For="() => model.City" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">State</label>
                        <InputText class="form-control" @bind-Value="model.State" />
                        <ValidationMessage For="() => model.State" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Country</label>
                        <InputText class="form-control" @bind-Value="model.Country" />
                        <ValidationMessage For="() => model.Country" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Zip code</label>
                        <InputText class="form-control" @bind-Value="model.ZipCode" />
                        <ValidationMessage For="() => model.ZipCode" />
                    </div>
                </div>

                <h5 class="mt-4">Payment</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Card holder</label>
                        <InputText class="form-control" @bind-Value="model.CardHolderName" />
                        <ValidationMessage For="() => model.CardHolderName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Card number</label>
                        <InputText class="form-control" @bind-Value="model.CardNumber" />
                        <ValidationMessage For="() => model.CardNumber" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Card type</label>
                        <InputSelect class="form-select" @bind-Value="model.CardTypeId">
                            <option value="1">Amex</option>
                            <option value="2">Visa</option>
                            <option value="3">MasterCard</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Expiration</label>
                        <InputDate class="form-control" @bind-Value="model.CardExpiration" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Security number</label>
                        <InputText class="form-control" @bind-Value="model.CardSecurityNumber" />
                        <ValidationMessage For="() => model.CardSecurityNumber" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-4" disabled="@isBusy">Place order</button>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; }

    //test values so the demo flow is quick
    private readonly BasketCheckout model = new()
    {
        Street = "Main Street 1",
        City = "Istanbul",
        State = "Istanbul",
        Country = "Turkey",
        ZipCode = "34000",
        CardHolderName = "Demo User",
        CardNumber = "4111111111111111",
        CardSecurityNumber = "123",
        CardExpiration = DateTime.UtcNow.Date.AddYears(2)
    };

    private bool isBusy;
    private bool completed;
    private string error;

    private async Task CheckoutAsync()
    {
        if (model.CardExpiration <= DateTime.UtcNow)
        {
            error = "Card is expired.";
            return;
        }

        isBusy = true;
        error = null;

        try
        {
            var state = await AuthenticationState;
            model.Buyer = state.User.Identity?.Name;

            completed = await BasketService.CheckoutAsync(model);

            if (!completed)
                error = "Checkout failed, is your basket empty?";
        }
        catch (HttpRequestException)
        {
            error = "Basket service is not reachable right now.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
