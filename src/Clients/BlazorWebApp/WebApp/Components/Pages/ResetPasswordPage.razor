@page "/reset-password"
@layout AuthLayout

<PageTitle>@L["Auth.ResetTitle"] · SellingBudy</PageTitle>

<AuthShell Title="@L["Auth.ResetTitle"]" Subtitle="@L["Auth.ResetSubtitle"]">
    @if (submitted)
    {
        <Notice>@L["Auth.ResetNotAvailable"]</Notice>
    }

    <form class="col gap-lg" @onsubmit="Submit" novalidate>
        <Field Label="@L["Auth.NewPassword"]" Error="@Err("password")"><input class="input @Bad("password")" type="password" autocomplete="new-password" placeholder="@L["Auth.PasswordHint"]" @bind="password" /></Field>
        <Field Label="@L["Auth.NewPasswordRepeat"]" Error="@Err("repeat")"><input class="input @Bad("repeat")" type="password" autocomplete="new-password" placeholder="@L["Auth.PasswordRepeatHint"]" @bind="repeat" /></Field>
        <button type="submit" class="btn btn-primary btn-block">@L["Auth.UpdatePassword"]</button>
    </form>
</AuthShell>

@code {
    private string password, repeat;
    private bool submitted;
    private Dictionary<string, string> errors = new();

    private string Err(string key) => errors.GetValueOrDefault(key);

    private string Bad(string key) => errors.ContainsKey(key) ? "invalid" : null;

    private void Submit()
    {
        errors = new Dictionary<string, string>();

        if (string.IsNullOrEmpty(password) || password.Length < 8) errors["password"] = L["Validation.PasswordLength"];
        if (password != repeat) errors["repeat"] = L["Validation.PasswordMatch"];

        submitted = !errors.Any();
    }
}
