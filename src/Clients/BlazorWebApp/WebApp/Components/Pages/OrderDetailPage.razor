@page "/orders/{OrderNumber}"
@inject IOrderService OrderService

<PageTitle>Order detail</PageTitle>

<AuthorizeView>
    <Authorized>
        <a href="orders">&larr; My Orders</a>

        @if (order == null)
        {
            <p class="mt-3"><em>Loading...</em></p>
        }
        else
        {
            <h1 class="mt-2">Order <small class="text-muted">@order.OrderNumber</small></h1>
            <p>
                <span class="badge bg-secondary">@order.Status</span>
                <span class="ms-2">@order.Date.ToLocalTime().ToString("g")</span>
            </p>
            <p>@order.Street, @order.City @order.ZipCode, @order.Country</p>

            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Units</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.OrderItems)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.Units</td>
                            <td>@Money(item.UnitPrice)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <p class="fs-5 text-end">Total: <strong>@Money(order.Total)</strong></p>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string OrderNumber { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; }

    private OrderDetail order;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationState;

        if (state.User.Identity?.IsAuthenticated == true)
            order = await OrderService.GetOrderDetailAsync(OrderNumber);
    }

    private static string Money(decimal value) => value.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
}
