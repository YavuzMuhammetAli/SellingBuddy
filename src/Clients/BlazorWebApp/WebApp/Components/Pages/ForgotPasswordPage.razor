@page "/forgot-password"
@layout AuthLayout

<PageTitle>@L["Auth.ForgotPassword"] · SellingBudy</PageTitle>

<AuthShell Title="@L["Auth.ForgotPassword"]" Subtitle="@L["Auth.ForgotSubtitle"]">
    @if (submitted)
    {
        <Notice>@L["Auth.ResetNotAvailable"]</Notice>
    }

    <form class="col gap-lg" @onsubmit="Submit" novalidate>
        <Field Label="@L["Auth.Email"]" Error="@error"><input class="input @(error != null ? "invalid" : null)" type="email" autocomplete="email" placeholder="@L["Auth.EmailPlaceholder"]" @bind="email" /></Field>
        <button type="submit" class="btn btn-primary btn-block">@L["Auth.SendResetLink"]</button>
    </form>

    <a href="login" class="btn-link" style="justify-content:center"><AppIcon Name="arrow_back" /> @L["Auth.BackToLogin"]</a>
</AuthShell>

@code {
    private string email;
    private string error;
    private bool submitted;

    //no password reset backend yet, the address is only validated
    private void Submit()
    {
        error = string.IsNullOrWhiteSpace(email) || !email.Contains('@') ? L["Validation.Email"] : null;
        submitted = error == null;
    }
}
